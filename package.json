{
  "name": "@thatcatdev/browser-ai",
  "version": "1.0.1",
  "description": "Small language models and retrieval, running in the browser on the visitor's own machine.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThatCatDev/browser-ai.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3 <5"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "webgpu",
    "wasm",
    "transformers",
    "embeddings",
    "rag",
    "llm",
    "browser"
  ]
}
